# ═══════════════════════════════════════════════════════════
# Parla — lokal / production ortam değişkenleri
# Kopyala:  cp .env.example .env.local
# ASLA git'e commit etme (.gitignore'da)
# ═══════════════════════════════════════════════════════════

# --- Zorunlu (lokal) ---
# SQLite dosyası (PC'de en kolayı). Production'da Turso kullan.
DATABASE_URL=file:.data/parla.db

# Oturum imzası — rastgele uzun bir string yap
JWT_SECRET=parla-local-dev-secret-change-me

# Demo mod: login atlanır, hazır hesapla açılır
DEMO_MODE=on

# Uygulama adresi (lokal)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Groq AI (ZORUNLU — gerçek öğretmen için) ---
# https://console.groq.com/keys  → Create API Key
GROQ_API_KEY=gsk_buraya_yapistir

# --- Opsiyonel: Turso (production / bulut DB) ---
# TURSO_DATABASE_URL=libsql://xxx.turso.io
# TURSO_AUTH_TOKEN=...

# --- Opsiyonel: Stripe (premium test) ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Opsiyonel: e-posta (Resend) ---
# RESEND_API_KEY=re_...

# --- Opsiyonel: Web Push ---
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=...
# VAPID_PRIVATE_KEY=...
