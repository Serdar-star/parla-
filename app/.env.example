# ═══════════════════════════════════════════════════════════
# Parla — PC / production ortam değişkenleri
# Kopyala:  cp .env.example .env.local
# ASLA git'e commit etme
# ═══════════════════════════════════════════════════════════

# --- Veritabanı (birini seç) ---
# A) PC hızlı başlangıç — dosya SQLite (önerilen ilk deneme)
DATABASE_URL=file:.data/parla.db

# B) Turso Cloud (kalıcı / Vercel) — A satırını yoruma al, bunları aç:
# DATABASE_URL=libsql://parla-xxxx.turso.io
# TURSO_DATABASE_URL=libsql://parla-xxxx.turso.io
# TURSO_AUTH_TOKEN=eyJhbGciOi...

# C) Yerel Turso sunucusu (sqld) — gelişmiş:
# DATABASE_URL=http://127.0.0.1:8080

# --- Zorunlu ---
JWT_SECRET=parla-pc-dev-secret-change-me-uzun-yap
DEMO_MODE=on
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Groq AI (PC'de GERÇEK çalışır) ---
# https://console.groq.com/keys  → Create API Key
GROQ_API_KEY=gsk_buraya_yapistir

# --- Opsiyonel: Stripe ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Opsiyonel: e-posta (Resend) ---
# RESEND_API_KEY=re_...

# --- Opsiyonel: Web Push ---
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=...
# VAPID_PRIVATE_KEY=...
